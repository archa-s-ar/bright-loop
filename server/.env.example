PORT=5000
NODE_ENV=development

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/brightloop"

JWT_SECRET=replace_with_local_secret
JWT_EXPIRES_IN=1d

# Frontend & CORS
CLIENT_URL=http://localhost:5000
APP_URL=http://localhost:5000

# Gmail SMTP (use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
# Use port 465 with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="Brightloop Software <your-gmail@gmail.com>"
