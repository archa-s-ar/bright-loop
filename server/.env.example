# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database (Prisma 6.19.3)
DATABASE_URL="mysql://root:password@localhost:3306/brightloop"

# Security & Authentication (JWT & Cookies)
JWT_SECRET=brightloop_jwt_secure_dev_secret_key_2026
JWT_EXPIRES_IN=1d
COOKIE_SECRET=brightloop_cookie_secret_key_2026

# Application URLs
CLIENT_URL=http://localhost:5000
APP_URL=http://localhost:5000

# Nodemailer / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Brightloop Software <no-reply@brightloop.local>"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Recurring Billing Scheduler (Node Cron)
BILLING_CRON_SCHEDULE="0 0 * * *"
